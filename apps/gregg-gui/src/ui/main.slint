// Plan 192: the Slint definition of the optional Gregg desktop frontend.
//
// ONE surface: a tray pulldown.
//
// The tray's CLICK opens the pulldown, and the pulldown carries the content:
// the fleet summary, the host list, the selected host's metrics, drives,
// interfaces, cron, records and `EggPool`, the forms that add, remove and
// edit hosts, and the application's own `Reload`, `About` and `Quit`.
//
// The native tray menu is NOT the dropdown. On macOS it is detached
// altogether — AppKit routes a click to the tray's `clicked` callback only
// when no menu is attached to the status item — so the pulldown has to carry
// `Quit` itself. On Windows and Linux the native menu is the *context* menu,
// reached with a right-click, and it carries `Quit Gregg` and nothing else:
// the fleet, the metrics and the forms all live in the pulldown, which is the
// surface.
//
// Two independent top-level components live here, on purpose:
//
//   * `Pulldown`  — the panel the tray's click opens.
//   * `TrayIcon`  — the native tray entry.
//
// A Slint `SystemTrayIcon` is a *top-level* component: it is never a child of
// a window, and a tray-rooted component does not share `Globals` with a
// window-rooted one — each instance gets its own copy of every global. So
// anything both of them need has to be pushed into each of them explicitly
// from Rust, which is where the truth lives anyway.
//
// The pulldown is borderless and always on top, so it draws its own shape: a
// rounded card, a soft shadow and a pointer toward the tray item. Slint 1.18
// does not expose the tray item's own position, so the pointer aims at the
// platform's trailing corner — where the tray usually is — and that is an
// approximation, stated as one.
//
// The pulldown's SIZE is the Rust side's business: Slint 1.18 cannot report
// a layout's preferred size to a `.slint` file, so the height that follows
// the content is computed where the content is known — in the model — and
// pushed in here as `pulldown-height`. Two properties carry the parts that
// vary inside the pulldown: the height of the bounded host list, and the
// height of the form.
//
// The two lists that grow with the fleet are the host list and the scheduler
// job list, and both live in a `ScrollView`. The rest of the fleet's detail
// — the metrics, the drives, the cron, the records and `EggPool` — lives in
// one more `ScrollView`, so the scroll model is one scroll model: the host
// list is bounded, and the detail below it scrolls as a whole.
//
// The colours come from Slint's `Palette` global, which follows the
// desktop's own colour scheme, and the buttons and the text fields come
// from `std-widgets`, which are styled to match the desktop. The palette
// used to be hard-coded monochrome, which made the panel look like a
// foreign object on a dark desktop, and the buttons used to be hand-rolled
// with no hover and no pressed state — which is exactly what a popover
// operated with the pointer already over it cannot do without.

import { Button, LineEdit, Palette, ScrollView } from "std-widgets.slint";

/// One measured column of a host's status strip.
///
/// The columns are the ones that mean a **used share**: the CPU, the memory,
/// the swap or the commit, the disk and the network. A reading that is not a
/// used share — a load, a frequency, an I/O wait — has no column here, so it
/// can never be drawn as a bar that means something else.
export struct FleetCell {
    /// The share as text, e.g. `39%`.
    ///
    /// An em dash when the platform reported no share at all: a missing
    /// reading is not a reading of zero.
    pct_text: string,
    /// The share of the column that is used, in `0..=1`.
    ///
    /// Negative when there is no reading at all, so that an empty bar says
    /// "not measured" rather than "measured as zero".
    fraction: float,
    /// The text that follows the share, when the column has one.
    ///
    /// Only the CPU column has one: the frequency, right after the CPU
    /// percentage.
    extra: string,
}

/// One host's condensed status strip: the fleet view's one row.
///
/// It is the TUI's condensed row with the fleet's five used shares in it: the
/// name carries the I/O-wait token, the CPU column carries the percentage and
/// then the frequency, and the load carries the one-minute average.
export struct FleetRow {
    /// The host's stable id.
    ///
    /// The panel's actions name the host by this and not by its place in
    /// the list: the fleet can reorder between the moment the list was
    /// drawn and the moment a row is clicked, and an action aimed at the
    /// wrong host is not something a stale index may do.
    id: string,
    /// The display name, or the host when the system has no configured name.
    ///
    /// The endpoint is not here: the compact fleet row names the host and
    /// not where it is, the way the TUI's condensed row does.
    name: string,
    /// The inline I/O-wait token, e.g. `IO 1.2%`.
    ///
    /// Empty when the platform does not report one: the token is omitted
    /// rather than shown as `IO 0.0%`.
    io_token: string,
    /// The one-minute load average, e.g. `6.76`.
    ///
    /// Empty when the platform does not report a load.
    load: string,
    /// The host's state in words, including the reason when it is offline.
    status: string,
    /// Whether the most recent poll succeeded.
    online: bool,
    /// Whether this is the host the detail pane is showing.
    selected: bool,
    /// The CPU column.
    cpu: FleetCell,
    /// The memory column.
    memory: FleetCell,
    /// The swap-or-commit column.
    swap: FleetCell,
    /// The disk column.
    disk: FleetCell,
    /// The network column.
    network: FleetCell,
}

/// One labelled value, used for the detail and EggPool panes.
export struct ValueRow {
    /// The short label.
    label: string,
    /// The formatted value.
    value: string,
}

/// One measured row, with the bar that shows its share.
///
/// The TUI draws the same measures as `label [bar] share value`, so the two
/// read the same way: the bar is the share, the share is a column of its
/// own, and the value is what the share does not say.
export struct MetricRow {
    /// The short label, e.g. `CPU`.
    label: string,
    /// The share as text, e.g. `39.4%`. Empty when the platform reported none.
    pct_text: string,
    /// The share of the row that is used, in `0..=1`.
    ///
    /// Negative when there is no reading at all, so that an empty bar says
    /// "not measured" rather than "measured as zero".
    fraction: float,
    /// The value that is not a share, e.g. `6.1 / 15.5 GiB`.
    value: string,
}

/// One scheduler job, as the cron pane shows it.
export struct JobRow {
    /// The job's name.
    name: string,
    /// The job's current scheduling state.
    state: string,
    /// Its last terminal outcome.
    outcome: string,
    /// Whether this is the job whose records are shown.
    selected: bool,
}

/// What the panel is showing.
export enum PanelMode {
    /// The fleet: one row per host, with its bars.
    Fleet,
    /// The selected host's detail: its metrics, drives, interfaces, cron,
    /// records and `EggPool`.
    Detail,
    /// The form that adds a host.
    AddHost,
    /// The form that edits one host.
    EditHost,
}

/// A quiet text link: it reads as a menu entry, not as a button.
component Link inherits Rectangle {
    /// The link's text.
    in property <string> label: "";

    /// Whether the link does anything.
    in property <bool> enabled: true;

    /// The operator followed the link.
    callback activated();

    background: link-touch.has-hover && root.enabled ? Palette.alternate-background : #00000000;
    border-radius: 4px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    preferred-width: label-text.preferred-width + 10px;
    preferred-height: 18px;

    label-text := Text {
        text: root.label;
        font-size: 11px;
        color: root.enabled ? Palette.accent-background : Palette.foreground;
        wrap: no-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    link-touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.activated();
        }
    }
}

/// A usage bar: a track with a filled share of it.
///
/// The track is the card's own border colour and the fill is the system's
/// accent, so the bar follows the desktop's scheme instead of a colour
/// chosen here. A row with no reading leaves the bar empty: an empty bar
/// says "not measured", and the row's own text says the same thing.
component UsageBar inherits Rectangle {
    /// The share that is filled, in `0..=1`.
    in property <float> fraction: 0;

    /// Whether the row carries a reading at all.
    in property <bool> measured: false;

    /// Whether the bar sits on a selected row.
    ///
    /// A selected row is tinted with the selection colour, and the accent
    /// fill would disappear into it, so the fill takes the selection's own
    /// foreground instead.
    in property <bool> selected: false;

    border-radius: root.height / 2;
    // The track is the foreground at a tenth of its strength: a bar's track
    // is a filled area, not an edge, so it is not the card's hairline.
    background: root.selected
        ? Palette.selection-foreground.with-alpha(0.30)
        : Palette.foreground.with-alpha(0.15);

    // The fill's origin is **written down**, and that is not decoration.
    //
    // Slint centres a child that has an explicit size and no explicit `x`/`y`
    // inside a parent that is not a layout (`maybe_center_in_parent` in the
    // compiler's `default_geometry` pass), so a fill without an `x` grows out
    // of the *middle* of its track instead of from its left edge. The `x` and
    // the `y` say which corner the bar starts at.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.measured ? max(0px, root.width * root.fraction) : 0px;
        height: root.height;
        border-radius: root.height / 2;
        background: root.selected ? Palette.selection-foreground : Palette.accent-background;
    }
}

/// One column's heading in the fleet table.
///
/// The heading is the column's name and nothing else: the rows below it say
/// what is in it, and the heading is quiet so that it does not compete with
/// the numbers.
component ColumnHeading inherits Text {
    /// The heading's text.
    in property <string> heading: "";

    /// The heading's colour.
    in property <color> heading-color: #0000007F;

    text: root.heading;
    font-size: 10px;
    font-weight: 700;
    color: root.heading-color;
    vertical-alignment: center;
    overflow: elide;
    wrap: no-wrap;
}

/// One measured column of a host's row: the bar and the share beside it.
///
/// The bar is the share and the number is the share, the way the TUI's own
/// metric rows read: the bar says how much of the capacity is used, and the
/// number says how exactly.
component FleetColumn inherits Rectangle {
    /// The column's reading.
    in property <FleetCell> cell: { pct_text: "", fraction: -1, extra: "" };

    /// Whether the host's row is selected.
    in property <bool> selected: false;

    /// The width of the bar.
    in property <length> bar-width: 24px;
    /// The height of the bar.
    in property <length> bar-height: 6px;
    /// The width of the share's column.
    in property <length> pct-width: 26px;
    /// The gap between the bar and the share.
    in property <length> gap: 4px;

    background: #00000000;

    UsageBar {
        x: 0px;
        y: (root.height - root.bar-height) / 2;
        width: root.bar-width;
        height: root.bar-height;
        fraction: root.cell.fraction;
        measured: root.cell.fraction >= 0;
        selected: root.selected;
    }

    Text {
        x: root.bar-width + root.gap;
        y: 0px;
        width: root.pct-width;
        text: root.cell.pct_text;
        font-size: 11px;
        color: root.selected ? Palette.selection-foreground : Palette.foreground;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }
}

export component Pulldown inherits Window {
    title: "Gregg";
    // The pulldown is a popover, not a window: no chrome, and it stays above
    // whatever the operator is looking at.
    no-frame: true;
    always-on-top: true;

    /// The pulldown's size.
    ///
    /// The Rust side owns it: it knows the fleet and the rows, and Slint
    /// 1.18 cannot report a layout's preferred size back to a `.slint` file.
    /// The window's own `width` and `height` are left alone so that the
    /// size the Rust side sets is the size the pulldown has.

    /// The window's own background.
    ///
    /// On macOS a frameless window is transparent, so the card's rounded
    /// corners and the shadow are the desktop's own colours showing through.
    /// Windows and Linux have no transparent window, so the background is the
    /// card's own colour and the shadow reads as a soft edge instead.
    background: root.transparent-window ? #00000000 : Palette.background;

    /// Whether this platform can give the pulldown a transparent window.
    ///
    /// macOS can: a frameless window there is transparent, so the card's
    /// rounded corners and the shadow are the desktop's own colours showing
    /// through. Windows and Linux have no transparent window, so the
    /// background is the card's own colour and the shadow reads as a soft
    /// edge instead.
    in property <bool> transparent-window: false;

    /// Whether the pointer toward the tray item points at the top edge.
    ///
    /// The tray is at the top of the screen on macOS and Linux and at the
    /// bottom on Windows.
    in property <bool> pointer-at-top: true;

    /// The height of the bounded host list.
    in property <length> host-list-height: 94px;

    /// The height of the form.
    in property <length> form-height: 220px;

    /// The heading the fleet's swap-or-commit column carries.
    ///
    /// Swap and the Windows commit are alternatives, and one fleet may hold
    /// both, so the heading is the model's to say: `SWP`, `COMMIT`, or both.
    in property <string> swap-heading: "SWP";

    /// One line describing the client-daemon attachment.
    ///
    /// Empty when the attachment is healthy: there is nothing to say, and a
    /// line that says nothing is chrome.
    in property <string> status-text: "";

    /// The one-line fleet summary. It is also the header strip's title.
    in property <string> fleet-summary: "";

    /// The fleet, in display order.
    in property <[FleetRow]> hosts;

    /// The selected host's measured rows.
    in property <[MetricRow]> metrics;

    /// The selected host's drive and interface rows.
    in property <[ValueRow]> details;

    /// The selected host's scheduler jobs.
    in property <[JobRow]> jobs;

    /// The retained records of the open scheduler job.
    in property <string> cron-records: "";

    /// The `EggPool` plane.
    in property <[ValueRow]> eggpool;

    /// The attribution and about text. Empty until the operator asks for it.
    in property <string> about-text: "";

    /// What the operator is told about the desktop's system tray.
    ///
    /// Empty when the desktop has a tray, so the line is only ever on screen
    /// when it is true: with no tray, closing the pulldown quits Gregg.
    in property <string> tray-warning: "";

    /// What the panel is showing.
    in property <PanelMode> mode: PanelMode.Fleet;

    /// The endpoint the form is editing. Bound to the form's text field.
    in-out property <string> form-endpoint: "";

    /// The name the form is editing. Bound to the form's text field.
    in-out property <string> form-name: "";

    /// The form's heading.
    in property <string> form-title: "";

    /// What the form says about what it is about to do.
    in property <string> form-note: "";

    /// What the last attempt said.
    in property <string> panel-message: "";

    /// Whether the last attempt failed.
    in property <bool> panel-message-is-error: false;

    /// The label on the form's confirming button.
    in property <string> form-apply-text: "Add";

    /// Whether the form's confirming button does anything.
    in property <bool> form-can-apply: false;

    /// The operator asked for a configuration reload.
    callback refresh-requested();

    /// The operator asked to quit.
    callback quit-requested();

    /// The operator asked to close the pulldown.
    callback close-requested();

    /// The operator selected a host, by its stable id.
    callback host-selected(string);

    /// The operator asked for the other view: the detail of the selected
    /// host, or the fleet again.
    callback view-toggled();

    /// The operator selected a scheduler job, by name.
    callback job-selected(string);

    /// The operator asked for the about and attribution text.
    callback about-requested();

    /// The operator opened or closed the `EggPool` pane.
    callback eggpool-toggled();

    /// The operator asked for the form that adds a host.
    callback add-host-requested();

    /// The operator asked to edit a host, by its stable id.
    callback edit-host-requested(string);

    /// The operator asked to remove a host, by its stable id.
    callback remove-host-requested(string);

    /// The operator confirmed the form.
    callback form-submitted();

    /// The operator abandoned the form.
    callback form-cancelled();

    /// The form's endpoint field changed.
    callback endpoint-edited(string);

    /// The form's name field changed.
    callback name-edited(string);

    /// The header strip was dragged, by this much.
    callback dragged(length, length);

    /// The corner grip was dragged, by this much.
    callback resized(length, length);

    /// The operator finished moving or resizing the pulldown.
    ///
    /// It is the signal to remember the placement: the drag itself only moves
    /// the window, and a drag that is still in flight is not a placement the
    /// operator has settled on.
    callback geometry-changed();

    /// The selected host's stable id, or an empty string when nothing is
    /// selected.
    ///
    /// The host's own actions are aimed by id and not by a row's place in the
    /// list: the fleet can reorder between the moment the list was drawn and
    /// the moment the operator acts.
    in property <string> selected-host-id: "";

    /// The selected host's name and endpoint, for the actions' row.
    in property <string> selected-host-label: "";

    /// The room the vertical scrollbar takes out of the viewport.
    ///
    /// The scrollbar is drawn over the right-hand edge of the viewport, so
    /// the content is given the viewport width minus this. It is the widest
    /// the native scrollbars get (they grow on hover), so the row text is
    /// never under the scrollbar.
    private property <length> scrollbar-reserve: 16px;

    /// The padding inside the card.
    private property <length> pane-padding: 12px;

    /// The room the shadow takes around the card.
    private property <length> margin: 14px;

    /// The card's hairline.
    ///
    /// A native macOS popover has **no stroked outline**: its edge is the
    /// edge of the vibrant material, a step of about a tenth of the
    /// luminance. `NSColor.separatorColor` is that step — measured at
    /// `rgba(0, 0, 0, 0.098)` in the light scheme and
    /// `rgba(255, 255, 255, 0.098)` in the dark one.
    ///
    /// `Palette.border` is **not** it: in the light scheme it is `#00000073`,
    /// forty-five percent of black in a single pixel, which is a hard dark
    /// line drawn *around* the panel rather than an edge of it.
    private property <color> hairline:
        Palette.color-scheme == ColorScheme.dark ? #FFFFFF19 : #00000019;

    /// The colour of the text that is not the subject: a heading, a label.
    ///
    /// It is `NSColor.secondaryLabelColor`, the colour macOS uses for
    /// everything that is not the label of a control: `rgba(0, 0, 0, 0.498)`
    /// in the light scheme and `rgba(255, 255, 255, 0.549)` in the dark one.
    private property <color> secondary-text:
        Palette.color-scheme == ColorScheme.dark ? #FFFFFF8C : #0000007F;

    /// How dark the card's shadow is at its darkest.
    ///
    /// It is the shadow's *peak*, not the alpha of one step: the steps add
    /// up, and this is roughly what they add up to at the card's own edge.
    private property <float> shadow-strength: 0.20;

    /// The card's corner radius.
    private property <length> radius: 12px;

    /// The columns of a measured row.
    ///
    /// The label's column is wide enough for the longest label the model
    /// uses (`COMMIT`), the bar has a fixed width so every row's bar starts
    /// at the same place, and the share's column is wide enough for `100%`.
    private property <length> metric-label-width: 42px;
    private property <length> metric-bar-width: 76px;
    private property <length> metric-bar-height: 6px;
    private property <length> metric-share-width: 38px;
    private property <length> metric-row-height: 18px;

    /// The columns of the fleet table.
    ///
    /// The compact fleet view is a table: the headings sit above the rows and
    /// every row's bar starts at the same place, so the columns line up down
    /// the whole fleet. The widths are properties, so the headings and the
    /// rows cannot drift apart.
    ///
    /// The widths are measured, not guessed: a name is set in 13px bold, a
    /// number in 11px, and the columns are as wide as the widest thing that
    /// goes in them.
    private property <length> col-host-width: 136px;
    /// The room the host's name takes, before the I/O-wait token.
    private property <length> col-host-name-width: 82px;
    /// The room the I/O-wait token takes, e.g. `IO 87.5%`.
    private property <length> col-io-width: 50px;
    /// The gap between two columns.
    private property <length> col-gap: 6px;
    /// The width of every bar.
    private property <length> col-bar-width: 24px;
    /// The height of every bar.
    private property <length> col-bar-height: 6px;
    /// The width of a share's column, wide enough for `100%`.
    private property <length> col-pct-width: 26px;
    /// The width of the frequency's column.
    ///
    /// It is wide enough for the longest frequency the TUI's own formatter
    /// writes: `920.15MHz` is nine characters, and a frequency below a
    /// megahertz is `920000Hz`.
    private property <length> col-freq-width: 58px;
    /// The width of the load's column, wide enough for `40.15`.
    private property <length> col-load-width: 34px;
    /// The gap between a bar and the number beside it.
    private property <length> metric-gap: 4px;

    /// Where each column of the fleet table starts.
    ///
    /// The CPU column carries the frequency after its percentage, so it is
    /// wider than the others, and every column after it moves along.
    private property <length> x-cpu: root.col-host-width + root.col-gap;
    private property <length> x-cpu-pct: root.x-cpu + root.col-bar-width + root.metric-gap;
    private property <length> x-cpu-freq: root.x-cpu-pct + root.col-pct-width + root.metric-gap;
    private property <length> x-memory: root.x-cpu-freq + root.col-freq-width + root.col-gap;
    private property <length> x-swap: root.x-memory + root.col-bar-width + root.metric-gap + root.col-pct-width + root.col-gap;
    private property <length> x-disk: root.x-swap + root.col-bar-width + root.metric-gap + root.col-pct-width + root.col-gap;
    private property <length> x-network: root.x-disk + root.col-bar-width + root.metric-gap + root.col-pct-width + root.col-gap;
    private property <length> x-load: root.x-network + root.col-bar-width + root.metric-gap + root.col-pct-width + root.col-gap;

    /// The width the fleet table needs.
    private property <length> table-width: root.x-load + root.col-load-width;

    /// The height of one host row in the fleet table.
    private property <length> host-row-height: 19px;

    /// The height of the table's headings.
    private property <length> heading-height: 14px;

    /// The height the attribution text takes when it is shown.
    private property <length> about-height: 56px;

    /// Where the pointer toward the tray item sits.
    ///
    /// The pulldown is anchored to the platform's **trailing** corner, and
    /// that is where the tray item is, so the pointer sits there too — a beak
    /// under the item it belongs to, the way a native popover's is. Slint
    /// 1.18 does not expose the tray item's own position, so the pointer
    /// follows the card's anchor rather than the item's exact place.
    ///
    /// The inset keeps the pointer's base on the card's flat edge, clear of
    /// the rounded corner.
    private property <length> pointer-width: 14px;
    private property <length> pointer-height: 7px;
    private property <length> pointer-inset: 16px;
    private property <length> pointer-x: root.width - root.margin - root.pointer-inset - root.pointer-width;

    /// The width the panes get: the card without its padding.
    private property <length> pane-width: root.width - 2 * root.margin - 2 * root.pane-padding;

    /// The width the content of a scroll container gets: the pane without
    /// the room the vertical scrollbar takes.
    private property <length> list-content-width: max(0px, root.pane-width - root.scrollbar-reserve);

    /// The keyboard handler. It is the window's focus target, so `Esc`
    /// reaches it even when a text field has the focus.
    forward-focus: key-handler;

    // The keyboard handler **wraps** the whole pulldown.
    //
    // Slint routes a key to the focused item and then, if the item rejects
    // it, up through that item's ancestors. A text field rejects `Esc` — it
    // has no meaning there — so a handler that merely sat beside the content
    // would never see the key while a field had the focus. Wrapping the
    // content makes the handler an ancestor of the fields, so `Esc` reaches
    // it from anywhere in the pulldown.
    //
    // `forward-focus` gives this scope the focus when the pulldown opens,
    // which is what makes `Esc` work before anything has been clicked.
    key-handler := FocusScope {
        // The card's shadow.
        //
        // Slint's software renderer does not draw drop shadows — its
        // `draw_box_shadow` is an empty stub — so the shadow is drawn: a
        // stack of thin rounded rectangles behind the card, each one pixel
        // further out and a little fainter than the last.
        //
        // The alphas follow a Gaussian falloff, so the *sum* of the steps is
        // one soft shadow that fades to nothing at the window's edge. A few
        // wide steps would read as a ring around the card instead, which is
        // what a hard shadow looks like on a bright desktop: a band, not a
        // shadow.
        for step in 14 : Rectangle {
            x: root.margin - (step + 1) * 1px;
            y: root.margin - (step + 1) * 1px;
            width: root.width - 2 * (root.margin - (step + 1) * 1px);
            height: root.height - 2 * (root.margin - (step + 1) * 1px);
            border-radius: root.radius + (step + 1) * 1px;
            background: rgba(0, 0, 0, root.shadow-strength * (exp(0.0 - step * step / 50.0) - exp(0.0 - (step + 1) * (step + 1) / 50.0)));
        }

        // The card. It is the pulldown's own shape: rounded, and outlined
        // so that it reads as a card even where the window cannot be
        // transparent and the corners are filled in.
        Rectangle {
            x: root.margin;
            y: root.margin;
            width: root.width - 2 * root.margin;
            height: root.height - 2 * root.margin;
            border-radius: root.radius;
            border-width: 1px;
            border-color: root.hairline;
            // The card's fill.
            //
            // A native macOS popover is a *vibrant material*: it transmits
            // most of what is behind it, desaturated and darkened on the way
            // through. Slint cannot blur the backdrop, so the closest thing
            // is a fill that lets a little of the desktop through — enough
            // that the panel belongs to the desktop rather than sitting on
            // it, and little enough that the text stays legible over any
            // wallpaper.
            background: Palette.background.with-alpha(0.94);

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // ------------------------------------------------ the header
                // The pulldown has no window chrome, so the header strip is
                // the pulldown's own title bar: it carries the summary, it
                // drags the pulldown, and it holds the close control.
                Rectangle {
                    height: 36px;
                    // The card's own background shows through: a square
                    // rectangle over a rounded card would cover the card's
                    // rounded corners.
                    background: #00000000;

                    // The drag area sits underneath the summary and the close
                    // control, so the close control still gets its click.
                    TouchArea {
                        moved => {
                            root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up) {
                                root.geometry-changed();
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 6px;
                        spacing: 8px;

                        Text {
                            text: root.fleet-summary;
                            font-size: 12px;
                            font-weight: 700;
                            color: Palette.foreground;
                            horizontal-stretch: 1;
                            overflow: elide;
                            wrap: no-wrap;
                            vertical-alignment: center;
                        }

                        // The close control. It is the pulldown's own
                        // dismiss affordance; the tray's click and `Esc`
                        // dismiss it too.
                        Rectangle {
                            preferred-width: 20px;
                            preferred-height: 20px;
                            horizontal-stretch: 0;
                            border-radius: 4px;
                            background: close-touch.has-hover ? Palette.alternate-background : #00000000;

                            close-touch := TouchArea {
                                clicked => {
                                    root.close-requested();
                                }
                            }

                            Text {
                                text: "×";
                                font-size: 15px;
                                color: Palette.foreground;
                                wrap: no-wrap;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // --------------------------------------------------- the body
                VerticalLayout {
                    padding: root.pane-padding;
                    spacing: 6px;
                    vertical-stretch: 1;

                    // The attachment's state. It takes no room at all when
                    // the attachment is healthy, because a hidden element
                    // still takes part in the layout.
                    Rectangle {
                        height: root.status-text == "" ? 0px : 18px;
                        visible: root.status-text != "";

                        Text {
                            text: root.status-text;
                            font-size: 11px;
                            color: Palette.foreground;
                            wrap: word-wrap;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }

                    // What the last action said. It is in the body rather than
                    // in a form, so the outcome of a removal is visible in the
                    // fleet view too.
                    Rectangle {
                        height: root.panel-message == "" ? 0px : 30px;
                        visible: root.panel-message != "";

                        Text {
                            text: root.panel-message;
                            font-size: 11px;
                            font-weight: root.panel-message-is-error ? 700 : 400;
                            color: root.panel-message-is-error ? Palette.accent-background : Palette.foreground;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                    }

                    // The tray warning. It takes no room at all unless the
                    // desktop really has no tray, because a hidden element still
                    // takes part in the layout.
                    Rectangle {
                        height: root.tray-warning == "" ? 0px : 18px;
                        visible: root.tray-warning != "";

                        Text {
                            text: root.tray-warning;
                            font-size: 11px;
                            color: Palette.foreground;
                            wrap: word-wrap;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }

                    // ------------------------------------------------ the fleet
                    //
                    // The compact fleet view: the TUI's condensed fleet row,
                    // with a bar for each of the five used shares. One row per
                    // host and nothing else — the host's detail is behind the
                    // footer's own control.
                    if root.mode == PanelMode.Fleet : VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 1;

                        // The table's headings. They sit above the list and do
                        // not scroll with it, so the columns keep their names
                        // while the rows move under them.
                        Rectangle {
                            height: root.heading-height;
                            background: #00000000;

                            ColumnHeading {
                                x: 0px;
                                y: 0px;
                                width: root.col-host-width;
                                heading: "HOST";
                                heading-color: root.secondary-text;
                            }
                            ColumnHeading {
                                x: root.x-cpu;
                                y: 0px;
                                width: root.col-bar-width;
                                heading: "CPU";
                                heading-color: root.secondary-text;
                            }
                            ColumnHeading {
                                x: root.x-memory;
                                y: 0px;
                                width: root.col-bar-width;
                                heading: "MEM";
                                heading-color: root.secondary-text;
                            }
                            ColumnHeading {
                                x: root.x-swap;
                                y: 0px;
                                width: root.col-bar-width;
                                heading: root.swap-heading;
                                heading-color: root.secondary-text;
                            }
                            ColumnHeading {
                                x: root.x-disk;
                                y: 0px;
                                width: root.col-bar-width;
                                heading: "DISK";
                                heading-color: root.secondary-text;
                            }
                            ColumnHeading {
                                x: root.x-network;
                                y: 0px;
                                width: root.col-bar-width;
                                heading: "NET";
                                heading-color: root.secondary-text;
                            }
                            ColumnHeading {
                                x: root.x-load;
                                y: 0px;
                                width: root.col-load-width;
                                heading: "LOAD";
                                heading-color: root.secondary-text;
                            }
                        }

                        // The fleet. Clicking a row selects that host; the
                        // selection is keyed by the stable system id on the Rust
                        // side, so a host that reorders does not move the
                        // selection.
                        //
                        // The list is in a scroll container with a bounded
                        // height: a fleet can be large, and an unbounded list
                        // would push the pulldown off the desktop.
                        ScrollView {
                            content-width: root.list-content-width;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            preferred-height: root.host-list-height;
                            max-height: root.host-list-height;
                            min-height: min(root.host-list-height, root.host-row-height);

                            VerticalLayout {
                                width: root.list-content-width;
                                spacing: 0px;

                                for row in root.hosts : Rectangle {
                                    height: root.host-row-height;
                                    background: row.selected ? Palette.selection-background : #00000000;

                                    // Under the row's contents, so the row's
                                    // own contents still get their clicks.
                                    TouchArea {
                                        clicked => {
                                            root.host-selected(row.id);
                                        }
                                    }

                                    // The host's name, and the I/O-wait token
                                    // beside it. The endpoint is not here: the
                                    // compact row names the host and not where
                                    // it is, the way the TUI's condensed row
                                    // does.
                                    Text {
                                        x: 0px;
                                        y: 0px;
                                        width: root.col-host-name-width;
                                        text: row.name;
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: row.selected ? Palette.selection-foreground : Palette.foreground;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }
                                    Text {
                                        x: root.col-host-name-width + 4px;
                                        y: 0px;
                                        width: root.col-io-width;
                                        text: row.io_token;
                                        font-size: 11px;
                                        color: row.selected ? Palette.selection-foreground : root.secondary-text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }

                                    // A host that is not online has no
                                    // readings, so its row says why it is
                                    // offline instead of carrying empty bars.
                                    // The status sits where the I/O-wait token
                                    // would be: right after the name, the way
                                    // the TUI's condensed row puts it.
                                    Text {
                                        x: root.col-host-name-width + 4px;
                                        y: 0px;
                                        width: root.table-width - root.col-host-name-width - 4px;
                                        text: row.status;
                                        font-size: 11px;
                                        color: row.selected ? Palette.selection-foreground : root.secondary-text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        wrap: no-wrap;
                                        visible: !row.online;
                                    }

                                    // The CPU column: the bar, the share, and
                                    // then the frequency — the reading that
                                    // follows the CPU percentage, the way the
                                    // TUI's own CPU row carries it.
                                    FleetColumn {
                                        x: root.x-cpu;
                                        y: 0px;
                                        width: root.col-bar-width + root.metric-gap + root.col-pct-width;
                                        height: root.host-row-height;
                                        cell: row.cpu;
                                        selected: row.selected;
                                    }
                                    Text {
                                        x: root.x-cpu-freq;
                                        y: 0px;
                                        width: root.col-freq-width;
                                        text: row.cpu.extra;
                                        font-size: 11px;
                                        color: row.selected ? Palette.selection-foreground : root.secondary-text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }

                                    FleetColumn {
                                        x: root.x-memory;
                                        y: 0px;
                                        width: root.col-bar-width + root.metric-gap + root.col-pct-width;
                                        height: root.host-row-height;
                                        cell: row.memory;
                                        selected: row.selected;
                                    }
                                    FleetColumn {
                                        x: root.x-swap;
                                        y: 0px;
                                        width: root.col-bar-width + root.metric-gap + root.col-pct-width;
                                        height: root.host-row-height;
                                        cell: row.swap;
                                        selected: row.selected;
                                    }
                                    FleetColumn {
                                        x: root.x-disk;
                                        y: 0px;
                                        width: root.col-bar-width + root.metric-gap + root.col-pct-width;
                                        height: root.host-row-height;
                                        cell: row.disk;
                                        selected: row.selected;
                                    }
                                    FleetColumn {
                                        x: root.x-network;
                                        y: 0px;
                                        width: root.col-bar-width + root.metric-gap + root.col-pct-width;
                                        height: root.host-row-height;
                                        cell: row.network;
                                        selected: row.selected;
                                    }

                                    // The load: the one-minute average, the
                                    // way the TUI's condensed row carries it.
                                    Text {
                                        x: root.x-load;
                                        y: 0px;
                                        width: root.col-load-width;
                                        text: row.load;
                                        font-size: 11px;
                                        color: row.selected ? Palette.selection-foreground : Palette.foreground;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }
                                }

                            }
                        }
                    }

                    // ------------------------------------------------ the detail
                    //
                    // The selected host's own numbers: its measured rows, its
                    // drives and its interfaces, its scheduler jobs and their
                    // records, and the `EggPool` plane. It is behind the
                    // footer's own control, so the fleet view stays a fleet
                    // view.
                    if root.mode == PanelMode.Detail : VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 1;

                        // Which host the detail is about. The host's own
                        // actions are in the pulldown's own footer, aimed at
                        // the selection, and not repeated here.
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            height: root.selected-host-id == "" ? 0px : 18px;
                            visible: root.selected-host-id != "";

                            Text {
                                text: root.selected-host-label;
                                font-size: 11px;
                                color: Palette.foreground;
                                horizontal-stretch: 1;
                                overflow: elide;
                                wrap: no-wrap;
                                vertical-alignment: center;
                            }
                        }

                        // The detail is one scroll container, so it scrolls as
                        // a whole and there is one scroll model.
                        ScrollView {
                            content-width: root.list-content-width;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            vertical-stretch: 1;

                            VerticalLayout {
                                width: root.list-content-width;
                                spacing: 0px;

                                Rectangle {
                                    min-height: 1px;
                                    max-height: 1px;
                                    background: root.hairline;
                                }

                                // A measured row: the label, the bar that shows
                                // the share, the share itself, and the value
                                // the share does not say. The columns are
                                // properties, so every row's bar starts at the
                                // same place and the row cannot drift from
                                // the pane it is laid out in.
                                for row in root.metrics : Rectangle {
                                    height: root.metric-row-height;

                                    Text {
                                        x: 0px;
                                        y: 0px;
                                        width: root.metric-label-width;
                                        text: row.label;
                                        font-size: 12px;
                                        color: Palette.foreground;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }

                                    UsageBar {
                                        x: root.metric-label-width + 4px;
                                        y: (root.metric-row-height - root.metric-bar-height) / 2;
                                        width: root.metric-bar-width;
                                        height: root.metric-bar-height;
                                        fraction: row.fraction;
                                        measured: row.fraction >= 0;
                                    }

                                    Text {
                                        x: root.metric-label-width + 4px + root.metric-bar-width + 6px;
                                        y: 0px;
                                        width: root.metric-share-width;
                                        text: row.pct_text;
                                        font-size: 12px;
                                        color: Palette.foreground;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }

                                    Text {
                                        x: root.metric-label-width + 4px + root.metric-bar-width + 6px + root.metric-share-width + 8px;
                                        y: 0px;
                                        width: max(0px, root.list-content-width - (root.metric-label-width + 4px + root.metric-bar-width + 6px + root.metric-share-width + 8px));
                                        text: row.value;
                                        font-size: 12px;
                                        color: Palette.foreground;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }
                                }

                                for row in root.details : Text {
                                    text: row.label + "  " + row.value;
                                    font-size: 12px;
                                    color: Palette.foreground;
                                    overflow: elide;
                                    wrap: no-wrap;
                                }

                                Rectangle {
                                    min-height: 1px;
                                    max-height: 1px;
                                    background: root.hairline;
                                    visible: root.jobs.length > 0;
                                }

                                for job in root.jobs : Rectangle {
                                    height: 22px;
                                    background: job.selected ? Palette.selection-background : #00000000;

                                    TouchArea {
                                        clicked => {
                                            root.job-selected(job.name);
                                        }
                                    }

                                    Text {
                                        text: job.name + "  " + job.state + "  " + job.outcome;
                                        font-size: 12px;
                                        color: job.selected ? Palette.selection-foreground : Palette.foreground;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }
                                }

                                Text {
                                    text: root.cron-records;
                                    font-size: 11px;
                                    color: Palette.foreground;
                                    wrap: word-wrap;
                                    overflow: elide;
                                }

                                Rectangle {
                                    min-height: 1px;
                                    max-height: 1px;
                                    background: root.hairline;
                                    visible: root.eggpool.length > 0;
                                }

                                for row in root.eggpool : Text {
                                    text: row.label + "  " + row.value;
                                    font-size: 12px;
                                    color: Palette.foreground;
                                    overflow: elide;
                                    wrap: no-wrap;
                                }
                            }
                        }
                    }

                    // The attribution and about block. It is empty — and
                    // therefore invisible — until the operator asks for it,
                    // and it is outside the detail so that it is readable
                    // from the fleet view too.
                    //
                    // It is wrapped in a rectangle with an explicit height for
                    // the same reason the status line and the message are: a
                    // `Text` takes a line of its own even when it is empty,
                    // and a line nobody asked for is a line the height
                    // calculation does not know about.
                    Rectangle {
                        height: root.about-text == "" ? 0px : root.about-height;
                        visible: root.about-text != "";

                        Text {
                            text: root.about-text;
                            font-size: 11px;
                            color: Palette.foreground;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                    }

                    // --------------------------------------------------- the forms
                    if root.mode == PanelMode.AddHost : ScrollView {
                        content-width: root.list-content-width;
                        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        preferred-height: root.form-height;
                        max-height: root.form-height;

                        VerticalLayout {
                            width: root.list-content-width;
                            spacing: 8px;

                            Text {
                                text: root.form-title;
                                font-size: 13px;
                                font-weight: 700;
                                color: Palette.foreground;
                            }

                            Text {
                                text: root.form-note;
                                font-size: 11px;
                                color: Palette.foreground;
                                wrap: word-wrap;
                                overflow: elide;
                            }

                            Text {
                                text: "Endpoint";
                                font-size: 11px;
                                font-weight: 700;
                                color: Palette.foreground;
                            }

                            LineEdit {
                                text <=> root.form-endpoint;
                                placeholder-text: "host:port";
                                edited => {
                                    root.endpoint-edited(self.text);
                                }
                            }

                            Text {
                                text: "Name (optional)";
                                font-size: 11px;
                                font-weight: 700;
                                color: Palette.foreground;
                            }

                            LineEdit {
                                text <=> root.form-name;
                                placeholder-text: "a name for this host";
                                edited => {
                                    root.name-edited(self.text);
                                }
                            }

                            Rectangle {
                                min-height: 1px;
                                max-height: 1px;
                                background: root.hairline;
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;

                                Button {
                                    text: "Cancel";
                                    clicked => {
                                        root.form-cancelled();
                                    }
                                }
                                Button {
                                    text: root.form-apply-text;
                                    enabled: root.form-can-apply;
                                    primary: true;
                                    clicked => {
                                        root.form-submitted();
                                    }
                                }
                            }
                        }
                    }

                    if root.mode == PanelMode.EditHost : ScrollView {
                        content-width: root.list-content-width;
                        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        preferred-height: root.form-height;
                        max-height: root.form-height;

                        VerticalLayout {
                            width: root.list-content-width;
                            spacing: 8px;

                            Text {
                                text: root.form-title;
                                font-size: 13px;
                                font-weight: 700;
                                color: Palette.foreground;
                            }

                            Text {
                                text: root.form-note;
                                font-size: 11px;
                                color: Palette.foreground;
                                wrap: word-wrap;
                                overflow: elide;
                            }

                            Text {
                                text: "Endpoint";
                                font-size: 11px;
                                font-weight: 700;
                                color: Palette.foreground;
                            }

                            LineEdit {
                                text <=> root.form-endpoint;
                                placeholder-text: "host:port";
                                edited => {
                                    root.endpoint-edited(self.text);
                                }
                            }

                            Text {
                                text: "Name (optional)";
                                font-size: 11px;
                                font-weight: 700;
                                color: Palette.foreground;
                            }

                            LineEdit {
                                text <=> root.form-name;
                                placeholder-text: "a name for this host";
                                edited => {
                                    root.name-edited(self.text);
                                }
                            }

                            Rectangle {
                                min-height: 1px;
                                max-height: 1px;
                                background: root.hairline;
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;

                                Button {
                                    text: "Cancel";
                                    clicked => {
                                        root.form-cancelled();
                                    }
                                }
                                Button {
                                    text: root.form-apply-text;
                                    enabled: root.form-can-apply;
                                    primary: true;
                                    clicked => {
                                        root.form-submitted();
                                    }
                                }
                            }
                        }
                    }
                }

                // --------------------------------------------------- the footer
                // The pulldown's own actions. They are links, not buttons:
                // they are menu entries, and a dropdown's entries are quiet.
                // On macOS the native tray menu is detached, so `Quit` is
                // here or nowhere.
                Rectangle {
                    height: 18px;
                    background: #00000000;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 6px;
                        spacing: 4px;
                        alignment: start;

                        Link {
                            label: "Reload";
                            activated => {
                                root.refresh-requested();
                            }
                        }

                        Link {
                            label: "Add host";
                            visible: root.mode == PanelMode.Fleet || root.mode == PanelMode.Detail;
                            activated => {
                                root.add-host-requested();
                            }
                        }

                        Link {
                            label: "EggPool";
                            visible: root.mode == PanelMode.Detail;
                            activated => {
                                root.eggpool-toggled();
                            }
                        }

                        // The two views. The fleet is a list of hosts and
                        // their bars; the detail is the selected host's own
                        // numbers, its drives, its interfaces, its scheduler
                        // and the `EggPool` plane. The control says which one
                        // the other one is.
                        Link {
                            label: root.mode == PanelMode.Detail ? "Fleet" : "Detail";
                            visible: root.mode == PanelMode.Fleet || root.mode == PanelMode.Detail;
                            activated => {
                                root.view-toggled();
                            }
                        }

                        // The selected host's own actions. They live in the
                        // pulldown's own affordances, and not on every row: a
                        // button on every row crowds the row and blurs into
                        // the selection tint.
                        Link {
                            label: "Edit";
                            enabled: root.selected-host-id != "";
                            activated => {
                                root.edit-host-requested(root.selected-host-id);
                            }
                        }

                        Link {
                            label: "Remove";
                            enabled: root.selected-host-id != "";
                            activated => {
                                root.remove-host-requested(root.selected-host-id);
                            }
                        }

                        Link {
                            label: "About";
                            activated => {
                                root.about-requested();
                            }
                        }

                        Link {
                            label: "Quit";
                            activated => {
                                root.quit-requested();
                            }
                        }
                    }
                }
            }
        }

        // The pointer toward the tray item.
        //
        // It is drawn twice: once in the card's border colour and a little
        // larger, and once in the card's own colour on top of it, so the
        // pointer has an edge where the window cannot be transparent and the
        // card's own colour would otherwise hide it.
        //
        // The base of both triangles sits on the card's edge, so the card's
        // outline runs into the pointer's outline instead of crossing it.
        Path {
            visible: root.pointer-at-top;
            x: root.pointer-x;
            y: root.margin - root.pointer-height;
            width: root.pointer-width;
            height: root.pointer-height;
            fit: ImageFit.fill;
            commands: "M 0 7 L 7 0 L 14 7 Z";
            fill: root.hairline;
        }

        Path {
            visible: root.pointer-at-top;
            x: root.pointer-x + 1px;
            y: root.margin - root.pointer-height + 2px;
            width: root.pointer-width - 2px;
            height: root.pointer-height - 2px;
            fit: ImageFit.fill;
            commands: "M 1 5 L 6 0 L 11 5 Z";
            fill: Palette.background.with-alpha(0.94);
        }

        Path {
            visible: !root.pointer-at-top;
            x: root.pointer-x;
            y: root.height - root.margin;
            width: root.pointer-width;
            height: root.pointer-height;
            fit: ImageFit.fill;
            commands: "M 0 0 L 14 0 L 7 7 Z";
            fill: root.hairline;
        }

        Path {
            visible: !root.pointer-at-top;
            x: root.pointer-x + 1px;
            y: root.height - root.margin;
            width: root.pointer-width - 2px;
            height: root.pointer-height - 2px;
            fit: ImageFit.fill;
            commands: "M 1 0 L 11 0 L 6 5 Z";
            fill: Palette.background.with-alpha(0.94);
        }

        // The resize grip, in the corner. The pulldown has no window frame,
        // so there is nothing else to resize it with.
        Rectangle {
            x: root.width - 2 * root.margin - 14px;
            y: root.height - 2 * root.margin - 14px;
            width: 14px;
            height: 14px;
            border-width: 1px;
            border-color: root.hairline;

            TouchArea {
                moved => {
                    root.resized(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up) {
                        root.geometry-changed();
                    }
                }
            }
        }

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }
    }
}

export component TrayIcon inherits SystemTrayIcon {
    /// The tray icon image.
    ///
    /// The inherited `icon` is bound to this one rather than assigned
    /// directly: a property that is bound in the `.slint` file is compiled as
    /// a constant, and a constant has no setter on the Rust side. The tray
    /// icon is only created once a non-empty image has been assigned, so this
    /// property is what the GUI fills in.
    in property <image> tray-icon;

    /// The hover text.
    ///
    /// Bound to the inherited `tooltip` for the same reason as `tray-icon`.
    in property <string> status-text: "Gregg";

    /// Whether this platform's tray carries a native menu.
    ///
    /// macOS does not: AppKit attaches the menu to the status item and pops
    /// it on a click, so a menu there would swallow the click that opens the
    /// pulldown. Windows and Linux keep theirs, where a right-click reaches
    /// it and a left-click does not.
    in property <bool> native-menu: false;

    /// The macOS menu-bar label. Windows and Linux ignore it.
    title: "Gregg";

    icon: root.tray-icon;
    tooltip: root.status-text;

    /// The operator asked to quit.
    callback quit-requested();

    /// The operator clicked the tray's icon.
    ///
    /// The tray's own `clicked` callback belongs to the `SystemTrayIcon`
    /// item, and a derived component does not re-export an inherited item's
    /// callback to the language binding — so it is forwarded to one of this
    /// component's own.
    callback tray-clicked();

    // The tray's click opens the pulldown.
    clicked => {
        root.tray-clicked();
    }

    // Exactly one `Menu` child, and nothing else.
    //
    // The menu is the tray's *context* menu: it carries `Quit Gregg` and
    // nothing else. The fleet, the metrics and the forms are the pulldown's,
    // and the pulldown is what the tray's click opens.
    //
    // The `if` is what detaches the menu on macOS. A menu with no entries
    // makes AppKit detach the menu from the status item, and a status item
    // with no menu routes its click to the tray's `clicked` callback.
    if root.native-menu : Menu {
        MenuItem {
            title: "Quit Gregg";
            activated => {
                root.quit-requested();
            }
        }
    }
}
