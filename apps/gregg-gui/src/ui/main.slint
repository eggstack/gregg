// Plan 191: the Slint definition of the optional Gregg desktop frontend.
//
// ONE surface: a tray pulldown.
//
// There is no separate monitor window. The panel that opens from the tray
// carries the fleet summary, the host list, the selected host's metrics,
// drives, interfaces, cron, records and `EggPool`, and the host-management
// forms.
//
// Two independent top-level components live here, on purpose:
//
//   * `Pulldown`  — the panel that opens from the tray.
//   * `TrayIcon`  — the native tray entry.
//
// A Slint `SystemTrayIcon` is a *top-level* component: it is never a child of
// a window, and a tray-rooted component does not share `Globals` with a
// window-rooted one — each instance gets its own copy of every global. So
// anything both of them need has to be pushed into each of them explicitly
// from Rust, which is where the truth lives anyway.
//
// The panel is borderless and always on top, so it carries its own chrome: a
// header strip that moves the window and closes it, and a grip in the corner
// that resizes it.
//
// The colours come from Slint's `Palette` global, which follows the
// desktop's own colour scheme, and the buttons and the text fields come
// from `std-widgets`, which are styled to match the desktop. The palette
// used to be hard-coded monochrome, which made the panel look like a
// foreign object on a dark desktop, and the buttons used to be hand-rolled
// with no hover and no pressed state — which is exactly what a popover
// operated with the pointer already over it cannot do without.
//
// The host list and the scheduler job list are the two lists that grow with
// the fleet, so both live in a `ScrollView`, and so do the metric rows: the
// panel is a fixed size, and an unbounded list would push the metrics, cron
// and `EggPool` panes — and the buttons — out of it. The scroll container
// owns the scrolling; there is no second scroll model on the Rust side.

import { Button, LineEdit, Palette, ScrollView } from "std-widgets.slint";

/// One monitored host, as the panel's host list and the tray menu show it.
export struct HostRow {
    /// The host's stable id.
    ///
    /// The panel's actions name the host by this and not by its place in
    /// the list: the fleet can reorder between the moment the list was
    /// drawn and the moment a row is clicked, and an action aimed at the
    /// wrong host is not something a stale index may do.
    id: string,
    /// Display name, or the host when the system has no configured name.
    name: string,
    /// The endpoint being polled, as `host:port`.
    endpoint: string,
    /// Reachability in words, including the reason when it is offline.
    status: string,
    /// The one-line metric summary.
    headline: string,
    /// Whether the most recent poll succeeded.
    online: bool,
    /// Whether this is the host the detail pane is showing.
    selected: bool,
}

/// One labelled value, used for the metric, detail and EggPool panes.
export struct ValueRow {
    /// The short label.
    label: string,
    /// The formatted value.
    value: string,
}

/// One scheduler job, as the cron pane shows it.
export struct JobRow {
    /// The job's name.
    name: string,
    /// The job's current scheduling state.
    state: string,
    /// Its last terminal outcome.
    outcome: string,
    /// Whether this is the job whose records are shown.
    selected: bool,
}

/// What the panel is showing.
export enum PanelMode {
    /// The fleet: metrics, drives, cron, records and `EggPool`.
    Metrics,
    /// The form that adds a host.
    AddHost,
    /// The form that edits one host.
    EditHost,
}

export component Pulldown inherits Window {
    title: "Gregg";
    // The panel is a popover, not a window: no chrome, and it stays above
    // whatever the operator is looking at.
    no-frame: true;
    always-on-top: true;
    width: 560px;
    height: 520px;
    background: Palette.background;

    /// One line describing the client-daemon attachment.
    in property <string> status-text: "connecting to the client daemon…";

    /// The one-line fleet summary. It is also the header strip's title.
    in property <string> fleet-summary: "";

    /// The fleet, in display order.
    in property <[HostRow]> hosts;

    /// The selected host's measured rows.
    in property <[ValueRow]> metrics;

    /// The selected host's drive and interface rows.
    in property <[ValueRow]> details;

    /// The selected host's scheduler jobs.
    in property <[JobRow]> jobs;

    /// The retained records of the open scheduler job.
    in property <string> cron-records: "";

    /// The `EggPool` plane.
    in property <[ValueRow]> eggpool;

    /// The attribution and about text. Empty until the operator asks for it.
    in property <string> about-text: "";

    /// What the operator is told about the desktop's system tray.
    ///
    /// Empty when the desktop has a tray, so the line is only ever on screen
    /// when it is true: with no tray, closing the panel quits Gregg.
    in property <string> tray-warning: "";

    /// What the panel is showing.
    in property <PanelMode> mode: PanelMode.Metrics;

    /// The endpoint the form is editing. Bound to the form's text field.
    in-out property <string> form-endpoint: "";

    /// The name the form is editing. Bound to the form's text field.
    in-out property <string> form-name: "";

    /// The form's heading.
    in property <string> form-title: "";

    /// What the form says about what it is about to do.
    in property <string> form-note: "";

    /// What the last attempt said.
    in property <string> panel-message: "";

    /// Whether the last attempt failed.
    in property <bool> panel-message-is-error: false;

    /// The label on the form's confirming button.
    in property <string> form-apply-text: "Add";

    /// Whether the form's confirming button does anything.
    in property <bool> form-can-apply: false;

    /// The operator asked for a configuration reload.
    callback refresh-requested();

    /// The operator asked to quit.
    callback quit-requested();

    /// The operator asked to close the panel.
    callback close-requested();

    /// The operator selected a host, by its stable id.
    callback host-selected(string);

    /// The operator selected a scheduler job, by name.
    callback job-selected(string);

    /// The operator asked for the about and attribution text.
    callback about-requested();

    /// The operator opened or closed the `EggPool` pane.
    callback eggpool-toggled();

    /// The operator asked for the form that adds a host.
    callback add-host-requested();

    /// The operator asked to edit a host, by its stable id.
    callback edit-host-requested(string);

    /// The operator asked to remove a host, by its stable id.
    callback remove-host-requested(string);

    /// The operator confirmed the form.
    callback form-submitted();

    /// The operator abandoned the form.
    callback form-cancelled();

    /// The form's endpoint field changed.
    callback endpoint-edited(string);

    /// The form's name field changed.
    callback name-edited(string);

    /// The header strip was dragged, by this much.
    callback dragged(length, length);

    /// The corner grip was dragged, by this much.
    callback resized(length, length);

    /// The room the vertical scrollbar takes out of the viewport.
    ///
    /// The scrollbar is drawn over the right-hand edge of the viewport, so
    /// the content is given the viewport width minus this. It is the widest
    /// the native scrollbars get (they grow on hover), so the row text is
    /// never under the scrollbar.
    private property <length> scrollbar-reserve: 16px;

    /// The padding inside the panel.
    private property <length> pane-padding: 12px;

    /// The width the panes get: the panel without its padding.
    private property <length> pane-width: root.width - 2 * root.pane-padding;

    /// The width the content of a scroll container gets: the pane without
    /// the room the vertical scrollbar takes.
    private property <length> list-content-width: max(0px, root.pane-width - root.scrollbar-reserve);

    /// The keyboard handler. It is the window's focus target, so `Esc`
    /// reaches it even when a text field has the focus.
    forward-focus: key-handler;

    // The keyboard handler **wraps** the whole panel.
    //
    // Slint routes a key to the focused item and then, if the item rejects
    // it, up through that item's ancestors. A text field rejects `Esc` — it
    // has no meaning there — so a handler that merely sat beside the content
    // would never see the key while a field had the focus. Wrapping the
    // content makes the handler an ancestor of the fields, so `Esc` reaches
    // it from anywhere in the panel.
    //
    // `forward-focus` gives this scope the focus when the panel opens, which
    // is what makes `Esc` work before anything has been clicked.
    key-handler := FocusScope {
        Rectangle {
            background: Palette.background;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // ---------------------------------------------------- the header
                // The panel has no window chrome, so the header strip is the
                // panel's own title bar: it carries the summary, it drags the
                // window, and it holds the close control.
                Rectangle {
                    height: 36px;
                    background: Palette.alternate-background;

                    // The drag area sits underneath the summary and the button,
                    // so the button still gets its click.
                    TouchArea {
                        moved => {
                            root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 6px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: root.fleet-summary;
                            font-size: 12px;
                            font-weight: 700;
                            color: Palette.foreground;
                            horizontal-stretch: 1;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        Button {
                            text: "Close";
                            clicked => {
                                root.close-requested();
                            }
                        }
                    }
                }

                // ------------------------------------------------------- the body
                VerticalLayout {
                    padding: root.pane-padding;
                    spacing: 6px;
                    vertical-stretch: 1;

                    Text {
                        text: root.status-text;
                        font-size: 12px;
                        font-weight: 700;
                        color: Palette.foreground;
                    }

                    // What the last action said. It is in the body rather than
                    // in a form, so the outcome of a removal is visible in the
                    // fleet view too.
                    Text {
                        text: root.panel-message;
                        font-size: 11px;
                        color: Palette.foreground;
                        wrap: word-wrap;
                        visible: root.panel-message != "";
                    }

                    // The tray warning. It takes no room at all unless the
                    // desktop really has no tray, because a hidden element still
                    // takes part in the layout.
                    Rectangle {
                        height: root.tray-warning == "" ? 0px : 18px;
                        visible: root.tray-warning != "";

                        Text {
                            text: root.tray-warning;
                            font-size: 11px;
                            color: Palette.foreground;
                        }
                    }

                    // ------------------------------------------------ the fleet
                    if root.mode == PanelMode.Metrics : VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 1;

                        // The host list. Clicking a row selects that host; the
                        // selection is keyed by the stable system id on the Rust
                        // side, so a host that reorders does not move the
                        // selection.
                        //
                        // The list is in a scroll container with a bounded
                        // height: a fleet can be large, and an unbounded list
                        // would push the metrics, cron and `EggPool` panes out of
                        // the panel.
                        ScrollView {
                            content-width: root.list-content-width;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            min-height: 66px;
                            max-height: 156px;
                            preferred-height: 110px;

                            VerticalLayout {
                                width: root.list-content-width;
                                spacing: 1px;

                                for row in root.hosts : Rectangle {
                                    height: 46px;
                                    background: row.selected ? Palette.selection-background : #00000000;

                                    // Under the row's contents, so the row's
                                    // own buttons still get their clicks.
                                    TouchArea {
                                        clicked => {
                                            root.host-selected(row.id);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 4px;
                                        spacing: 6px;
                                        alignment: center;

                                        VerticalLayout {
                                            spacing: 0px;
                                            horizontal-stretch: 1;

                                            Text {
                                                text: row.name + "  " + row.endpoint;
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: row.selected ? Palette.selection-foreground : Palette.foreground;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: row.status;
                                                font-size: 11px;
                                                color: row.selected ? Palette.selection-foreground : Palette.foreground;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: row.headline;
                                                font-size: 11px;
                                                color: row.selected ? Palette.selection-foreground : Palette.foreground;
                                                overflow: elide;
                                            }
                                        }

                                        Button {
                                            text: "Edit";
                                            clicked => {
                                                root.edit-host-requested(row.id);
                                            }
                                        }
                                        Button {
                                            text: "Remove";
                                            clicked => {
                                                root.remove-host-requested(row.id);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            min-height: 1px;
                            max-height: 1px;
                            background: Palette.border;
                        }

                        Text {
                            text: "METRICS";
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }

                        // The measured rows, bounded for the same reason as the
                        // host list: a host with a lot of metrics must not push
                        // the cron and `EggPool` panes out of the panel.
                        ScrollView {
                            content-width: root.list-content-width;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            visible: root.metrics.length > 0;
                            min-height: 40px;
                            max-height: 104px;
                            preferred-height: 76px;

                            VerticalLayout {
                                width: root.list-content-width;
                                spacing: 0px;

                                for row in root.metrics : Text {
                                    text: row.label + "  " + row.value;
                                    font-size: 12px;
                                    color: Palette.foreground;
                                    overflow: elide;
                                }
                            }
                        }

                        // The drive and interface rows.
                        ScrollView {
                            content-width: root.list-content-width;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            visible: root.details.length > 0;
                            min-height: 20px;
                            max-height: 72px;
                            preferred-height: 52px;

                            VerticalLayout {
                                width: root.list-content-width;
                                spacing: 0px;

                                for row in root.details : Text {
                                    text: row.label + "  " + row.value;
                                    font-size: 12px;
                                    color: Palette.foreground;
                                    overflow: elide;
                                }
                            }
                        }

                        Text {
                            text: "CRON";
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }

                        // The scheduler jobs, in a bounded scroll container for
                        // the same reason as the host list: a host with many jobs
                        // must not push the rest of the panel out of it.
                        ScrollView {
                            content-width: root.list-content-width;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            min-height: 44px;
                            max-height: 88px;
                            preferred-height: 66px;

                            VerticalLayout {
                                width: root.list-content-width;
                                spacing: 0px;

                                for job in root.jobs : Rectangle {
                                    height: 22px;
                                    background: job.selected ? Palette.selection-background : #00000000;

                                    TouchArea {
                                        clicked => {
                                            root.job-selected(job.name);
                                        }
                                    }

                                    Text {
                                        text: job.name + "  " + job.state + "  " + job.outcome;
                                        font-size: 12px;
                                        color: job.selected ? Palette.selection-foreground : Palette.foreground;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.cron-records;
                            font-size: 11px;
                            color: Palette.foreground;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "EGGPOOL";
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.foreground;
                            visible: root.eggpool.length > 0;
                        }

                        for row in root.eggpool : Text {
                            text: row.label + "  " + row.value;
                            font-size: 12px;
                            color: Palette.foreground;
                        }
                    }

                    // --------------------------------------------------- the forms
                    if root.mode == PanelMode.AddHost : VerticalLayout {
                        spacing: 8px;
                        vertical-stretch: 1;

                        Text {
                            text: root.form-title;
                            font-size: 13px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }

                        Text {
                            text: root.form-note;
                            font-size: 11px;
                            color: Palette.foreground;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Endpoint";
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }

                        LineEdit {
                            text <=> root.form-endpoint;
                            placeholder-text: "host:port";
                            edited => {
                                root.endpoint-edited(self.text);
                            }
                        }

                        Text {
                            text: "Name (optional)";
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }

                        LineEdit {
                            text <=> root.form-name;
                            placeholder-text: "a name for this host";
                            edited => {
                                root.name-edited(self.text);
                            }
                        }

                        Rectangle {
                            min-height: 1px;
                            max-height: 1px;
                            background: Palette.border;
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;

                            Button {
                                text: "Cancel";
                                clicked => {
                                    root.form-cancelled();
                                }
                            }
                            Button {
                                text: root.form-apply-text;
                                enabled: root.form-can-apply;
                                primary: true;
                                clicked => {
                                    root.form-submitted();
                                }
                            }
                        }
                    }

                    if root.mode == PanelMode.EditHost : VerticalLayout {
                        spacing: 8px;
                        vertical-stretch: 1;

                        Text {
                            text: root.form-title;
                            font-size: 13px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }

                        Text {
                            text: root.form-note;
                            font-size: 11px;
                            color: Palette.foreground;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Endpoint";
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }

                        LineEdit {
                            text <=> root.form-endpoint;
                            placeholder-text: "host:port";
                            edited => {
                                root.endpoint-edited(self.text);
                            }
                        }

                        Text {
                            text: "Name (optional)";
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }

                        LineEdit {
                            text <=> root.form-name;
                            placeholder-text: "a name for this host";
                            edited => {
                                root.name-edited(self.text);
                            }
                        }

                        Rectangle {
                            min-height: 1px;
                            max-height: 1px;
                            background: Palette.border;
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;

                            Button {
                                text: "Cancel";
                                clicked => {
                                    root.form-cancelled();
                                }
                            }
                            Button {
                                text: root.form-apply-text;
                                enabled: root.form-can-apply;
                                primary: true;
                                clicked => {
                                    root.form-submitted();
                                }
                            }
                        }
                    }

                    // --------------------------------------------------- the footer
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;

                        Button {
                            text: "Reload";
                            clicked => {
                                root.refresh-requested();
                            }
                        }
                        Button {
                            text: "Add host";
                            visible: root.mode == PanelMode.Metrics;
                            clicked => {
                                root.add-host-requested();
                            }
                        }
                        Button {
                            text: "EggPool";
                            visible: root.mode == PanelMode.Metrics;
                            clicked => {
                                root.eggpool-toggled();
                            }
                        }
                        Button {
                            text: "About";
                            clicked => {
                                root.about-requested();
                            }
                        }
                        Button {
                            text: "Quit";
                            primary: true;
                            clicked => {
                                root.quit-requested();
                            }
                        }
                    }
                }
            }
        }

        // The about and attribution block. It is empty — and therefore
        // invisible — until the operator asks for it.
        Text {
            x: root.pane-padding;
            y: root.height - 96px;
            width: root.pane-width;
            text: root.about-text;
            font-size: 11px;
            color: Palette.foreground;
            wrap: word-wrap;
            visible: root.about-text != "";
        }

        // The resize grip, in the corner. The panel has no window frame, so
        // there is nothing else to resize it with.
        Rectangle {
            x: root.width - 16px;
            y: root.height - 16px;
            width: 14px;
            height: 14px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                moved => {
                    root.resized(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
        }

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }
    }
}

export component TrayIcon inherits SystemTrayIcon {
    /// The tray icon image.
    ///
    /// The inherited `icon` is bound to this one rather than assigned
    /// directly: a property that is bound in the `.slint` file is compiled as
    /// a constant, and a constant has no setter on the Rust side. The tray
    /// icon is only created once a non-empty image has been assigned, so this
    /// property is what the GUI fills in.
    in property <image> tray-icon;

    /// The hover text.
    ///
    /// Bound to the inherited `tooltip` for the same reason as `tray-icon`.
    in property <string> status-text: "Gregg";

    /// The fleet summary, shown as the menu's header.
    ///
    /// It is a bound property rather than an assigned one, for the same
    /// reason: the inherited `title` is compiled as a constant.
    in property <string> summary-text: "";

    /// The hosts the menu offers to jump to.
    ///
    /// A native menu is not a scrollable viewport, so the list is bounded:
    /// the panel is the surface that carries the whole fleet.
    in property <[HostRow]> hosts;

    /// The macOS menu-bar label. Windows and Linux ignore it.
    title: "Gregg";

    icon: root.tray-icon;
    tooltip: root.status-text;

    /// The operator asked to open or close the panel.
    callback toggle-panel();

    /// The operator asked for a configuration reload.
    callback refresh-requested();

    /// The operator asked for the about and attribution text.
    callback about-requested();

    /// The operator asked to quit.
    callback quit-requested();

    /// The operator picked a host from the menu. The argument is its
    /// stable id.
    callback host-jump(string);

    // Exactly one `Menu` child, and nothing else.
    Menu {
        // The header is the fleet summary. It is not an action, so it is
        // disabled: a native menu has no read-only item that does not look
        // like a broken button.
        MenuItem {
            title: root.summary-text;
            enabled: false;
        }
        MenuSeparator {}

        // The hosts the operator can jump to. The panel opens with the
        // picked host selected.
        for host in root.hosts : MenuItem {
            title: host.name + "  " + host.endpoint;
            activated => {
                root.host-jump(host.id);
            }
        }

        MenuSeparator {}
        MenuItem {
            title: "Open Gregg";
            activated => {
                root.toggle-panel();
            }
        }
        MenuItem {
            title: "Reload";
            activated => {
                root.refresh-requested();
            }
        }
        MenuItem {
            title: "About Gregg";
            activated => {
                root.about-requested();
            }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit Gregg";
            activated => {
                root.quit-requested();
            }
        }
    }
}
