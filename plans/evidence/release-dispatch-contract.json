{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Machine-readable contract mapping each release-candidate dispatch stage to its reachable producer jobs, required logical stages, and boundary classification.",
  "dispatches": {
    "protocol-prepublish": {
      "mode": "candidate",
      "requires_prior_publication": false,
      "producer_jobs": ["resolve", "source-ci", "protocol-prepublish"],
      "required_stages": ["source-ci", "protocol-prepublish"],
      "aggregation": {
        "type": "current-run"
      }
    },
    "protocol-index-check": {
      "mode": "intermediate-publication",
      "requires_prior_publication": true,
      "producer_jobs": ["resolve", "protocol-index-check"],
      "required_stages": ["protocol-index-check"],
      "aggregation": {
        "type": "current-run"
      }
    },
    "binary-prepublish": {
      "mode": "candidate",
      "requires_prior_publication": false,
      "producer_jobs": ["resolve", "source-ci", "binary-prepublish", "binary-msrv"],
      "required_stages": [
        "source-ci",
        "binary-prepublish-greggd",
        "binary-prepublish-gregg",
        "binary-msrv-greggd",
        "binary-msrv-gregg"
      ],
      "aggregation": {
        "type": "current-run"
      }
    },
    "native-evidence": {
      "mode": "candidate",
      "requires_prior_publication": false,
      "producer_jobs": ["resolve", "source-ci", "native-evidence", "native-package-evidence"],
      "required_stages": [
        "source-ci",
        "native-source-linux-x86-64",
        "native-source-linux-arm64",
        "native-source-macos-arm64",
        "native-source-macos-intel",
        "native-package-linux-x86-64",
        "native-package-linux-arm64",
        "native-package-macos-arm64",
        "native-package-macos-intel"
      ],
      "aggregation": {
        "type": "current-run"
      }
    },
    "mixed-fleet-client": {
      "mode": "candidate",
      "requires_prior_publication": false,
      "producer_jobs": ["resolve", "source-ci", "mixed-fleet-client"],
      "required_stages": ["source-ci", "mixed-fleet-functional"],
      "aggregation": {
        "type": "current-run",
        "note": "mixed-fleet-sustained is NOT required; it is produced by a separate dispatch"
      }
    },
    "mixed-fleet-sustained": {
      "mode": "candidate",
      "requires_prior_publication": false,
      "producer_jobs": ["resolve", "source-ci", "mixed-fleet-sustained"],
      "required_stages": ["source-ci", "mixed-fleet-sustained"],
      "aggregation": {
        "type": "current-run",
        "note": "mixed-fleet-functional is NOT required; it is produced by a separate dispatch"
      }
    },
    "operational-evidence": {
      "mode": "candidate",
      "requires_prior_publication": false,
      "producer_jobs": ["resolve", "operational-evidence", "operational-macos-evidence", "systemd-lifecycle", "launchd-lifecycle"],
      "required_stages": [
        "resource-linux",
        "resource-macos-arm64",
        "soak-linux-24h",
        "soak-macos-arm64-24h",
        "systemd-lifecycle",
        "launchd-lifecycle"
      ],
      "aggregation": {
        "type": "current-run"
      }
    },
    "postpublish-verify": {
      "mode": "postpublication",
      "requires_prior_publication": true,
      "producer_jobs": ["resolve", "protocol-index-check", "postpublish-verify"],
      "required_stages": ["protocol-index-check", "postpublish-verify"],
      "aggregation": {
        "type": "current-run"
      }
    }
  }
}
